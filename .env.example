

# Railway gives postgres://... ; Settings rewrites it to the installed driver
DATABASE_URL=postgresql://user:password@localhost:5432/tetracore

# python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
# Production serves the UI and API from one origin, so this is mostly for local dev.
CORS_ORIGINS=http://localhost:5173

# A different random value. Changing it later invalidates ALL stored PINs.
PIN_PEPPER=

# Optional overrides (defaults shown)
# JWT_ISSUER=tetracore-log
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# MAX_PIN_ATTEMPTS=5
# LOCKOUT_MINUTES=15
